{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://repro.example.invalid/schemas/capsule-0.1.json",
  "title": "Repro capsule draft 0.1",
  "description": "Interchange draft, not an execution authorization or completed product implementation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "capsuleId",
    "classification",
    "adapter",
    "application",
    "oracle",
    "artifacts",
    "mockBoundaries",
    "supportedEnvironment"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1.0"
    },
    "capsuleId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,79}$"
    },
    "classification": {
      "enum": [
        "synthetic-development",
        "historical-development",
        "historical-holdout",
        "user-provided"
      ]
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceArtifact",
        "revision",
        "fixtureArtifact"
      ],
      "properties": {
        "sourceArtifact": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "fixtureArtifact": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "artifact",
        "sha256",
        "expectationBasis",
        "humanApproval"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "expectationBasis": {
          "enum": [
            "supplied-synthetic-specification",
            "independent-contract",
            "reporter-confirmed",
            "proposed-unconfirmed"
          ]
        },
        "humanApproval": {
          "enum": [
            "pending",
            "recorded",
            "not-claimed"
          ]
        },
        "approvalEvidenceArtifact": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "humanApproval": {
                "const": "recorded"
              }
            }
          },
          "then": {
            "required": [
              "approvalEvidenceArtifact"
            ]
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "sha256",
          "bytes",
          "mediaType"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "$ref": "#/$defs/sha256"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1073741824
          },
          "mediaType": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "mockBoundaries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dependency",
          "mode",
          "reason",
          "behaviorUnderTest"
        ],
        "properties": {
          "dependency": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "enum": [
              "execute-target",
              "synthetic-external-response",
              "unsupported"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "behaviorUnderTest": {
            "type": "boolean"
          }
        }
      }
    },
    "supportedEnvironment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "platform",
        "browser",
        "runnerVersion",
        "externalDependencies"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "browser": {
          "type": "string",
          "minLength": 1
        },
        "runnerVersion": {
          "type": "string",
          "minLength": 1
        },
        "externalDependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
